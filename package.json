{
  "name": "gladys-nasa",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for open NASA data: near-Earth asteroids (NeoWs), the whole Earth seen by EPIC (DSCOVR) and natural events near your houses (EONET), with scene triggers and dashboard widgets (not affiliated with NASA).",
  "homepage": "https://github.com/William-De71/gladys-nasa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-nasa.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "nasa",
    "neows",
    "asteroids",
    "epic",
    "dscovr",
    "eonet",
    "natural-events",
    "home-automation"
  ]
}
